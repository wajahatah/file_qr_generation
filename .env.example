# Password for the app and the /api/ routes. start.cmd generates a strong one on
# first run. To make your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me

# How long you stay signed in to the app.
ADMIN_SESSION_HOURS=12

# The OAuth client downloaded from Google Cloud (type "Desktop app").
# See docs/setup-guide.md, section 3.
GOOGLE_CLIENT_SECRET_FILE=./client_secret.json

DB_PATH=./file_qr.db
MAX_UPLOAD_BYTES=26214400

# How often expired QR codes are removed from Google Drive while the app runs.
SWEEP_INTERVAL_MINUTES=10

# Docker only. Time limits normally follow the laptop's own time zone (docker-start.cmd
# passes it in). Uncomment to force a zone instead, e.g. Asia/Karachi or Asia/Riyadh.
# TZ=Asia/Riyadh
