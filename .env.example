# Public origin the QR codes point at. MUST be the externally reachable HTTPS origin
# in production -- a QR encoding localhost is useless to a customer.
BASE_URL=https://qr.example.com

# Bearer token for every /api/ route. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me

# local | drive
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# Only used when STORAGE_BACKEND=drive -- see docs/setup-guide.md section 5
# for how to create the service account and find the folder ID.
DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# Least privilege by default. Only widen this to
# https://www.googleapis.com/auth/drive if uploads fail with a 404 on the folder.
DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

DB_PATH=./file_qr.db
DEFAULT_EXPIRY_DAYS=30
MAX_UPLOAD_BYTES=26214400
LOG_RETENTION_DAYS=90
